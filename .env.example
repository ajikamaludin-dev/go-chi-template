APP_NAME=chi-go-template
APP_ENV=development
APP_PORT=8080

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=secret
DB_MAX_OPEN=25
DB_MAX_IDLE=5
DB_MAX_LIFE=5m

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info
LOG_DIR=storage/logs
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30

OTEL_ENDPOINT=localhost:4317
OTEL_INSECURE=true

METRICS_ENABLED=true
METRICS_PATH=/metrics
